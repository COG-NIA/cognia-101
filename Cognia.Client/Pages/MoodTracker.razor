@page "/mood-tracker"

<PageTitle>Cognia | Mood Tracker</PageTitle>

<div class="tracker-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Daily reflection</p>
            <h1>Mood Tracker</h1>
        </div>
        <button class="primary-button" type="button">Check in today</button>
    </header>

    <section class="mood-grid" aria-label="Select a mood rating">
        <button class="mood-option happy" type="button">
            <span class="emoji" aria-hidden="true">😊</span>
            <span>Happy</span>
        </button>
        <button class="mood-option calm" type="button">
            <span class="emoji" aria-hidden="true">😌</span>
            <span>Calm</span>
        </button>
        <button class="mood-option neutral" type="button">
            <span class="emoji" aria-hidden="true">😐</span>
            <span>Neutral</span>
        </button>
        <button class="mood-option stressed" type="button">
            <span class="emoji" aria-hidden="true">😟</span>
            <span>Stressed</span>
        </button>
        <button class="mood-option anxious" type="button">
            <span class="emoji" aria-hidden="true">😵</span>
            <span>Anxious</span>
        </button>
    </section>

    <section class="reflection-panel">
        <div class="panel-copy">
            <h2>How are you feeling today?</h2>
            <p>Record a quick reflection to help you notice patterns and identify what brings you comfort or pressure.</p>
        </div>

        <div class="input-box">
            <label for="mood-note">What influenced your mood today?</label>
            <textarea id="mood-note" rows="4" placeholder="I felt overwhelmed by deadlines and then calmer after taking a walk."></textarea>
        </div>
    </section>

    <section class="history-panel">
        <h2>Recent check-ins</h2>
        <div class="history-list">
            <article class="history-item">
                <div>
                    <strong>Monday</strong>
                    <p>Felt more rested after a short walk and fewer notifications.</p>
                </div>
                <span class="badge calm">Calm</span>
            </article>
            <article class="history-item">
                <div>
                    <strong>Tuesday</strong>
                    <p>Academic pressure felt heavy, but journaling helped me reset.</p>
                </div>
                <span class="badge stressed">Stressed</span>
            </article>
            <article class="history-item">
                <div>
                    <strong>Wednesday</strong>
                    <p>Supportive conversation and a good sleep routine improved my mood.</p>
                </div>
                <span class="badge happy">Happy</span>
            </article>
        </div>
    </section>
</div>

<style>
    .tracker-shell {
        padding: 2rem;
        color: #1f2937;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .eyebrow {
        margin: 0 0 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        font-weight: 700;
        color: #4f46e5;
    }

    h1, h2, p {
        margin-top: 0;
    }

    .primary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.25rem;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #6d5efc, #8b5cf6);
        color: white;
        font-weight: 700;
        cursor: pointer;
    }

    .mood-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .mood-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-height: 120px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: white;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

    .emoji {
        font-size: 2rem;
    }

    .happy { background: #ecfdf5; }
    .calm { background: #eff6ff; }
    .neutral { background: #f3f4f6; }
    .stressed { background: #fff7ed; }
    .anxious { background: #fdf2f8; }

    .reflection-panel,
    .history-panel {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .reflection-panel {
        display: grid;
        grid-template-columns: 1.2fr 1.5fr;
        gap: 1.5rem;
    }

    .input-box {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    textarea {
        width: 100%;
        resize: vertical;
        border: 1px solid #d1d5db;
        border-radius: 12px;
        padding: 0.75rem 1rem;
        font: inherit;
    }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .history-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #fafafa;
    }

    .history-item p {
        margin: 0.35rem 0 0;
        color: #4b5563;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge.calm { background: #dbeafe; color: #1d4ed8; }
    .badge.stressed { background: #ffedd5; color: #c2410c; }
    .badge.happy { background: #d1fae5; color: #047857; }

    @@media (max-width: 640px) {
        .tracker-shell,
        .page-header,
        .reflection-panel,
        .history-item {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .page-header,
        .history-item,
        .reflection-panel {
            flex-direction: column;
            align-items: flex-start;
            grid-template-columns: 1fr;
        }
    }
</style>
