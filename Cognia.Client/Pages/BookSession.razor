@code {
    [Parameter]
    public int TherapistId { get; set; }

    private Therapist? therapist;
    private BookSessionRequest bookingReq = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        therapist = await BookingService.GetTherapistByIdAsync(TherapistId);
        if (therapist != null)
        {
            bookingReq.TherapistId = therapist.Id;
            bookingReq.SessionDate = DateTime.Today.AddDays(1);
            bookingReq.DurationMinutes = 60;
            bookingReq.SessionMode = "Encrypted Video Call";
            if (therapist.TimeSlots.Any())
            {
                bookingReq.TimeSlot = therapist.TimeSlots.First();
            }
        }
        isLoading = false;
    }

    private void SetSessionMode(string mode)
    {
        bookingReq.SessionMode = mode;
    }

    private void SetDuration(int mins)
    {
        bookingReq.DurationMinutes = mins;
    }

    private void AddFocusTag(string tag)
    {
        if (string.IsNullOrWhiteSpace(bookingReq.Notes))
        {
            bookingReq.Notes = $"Focus topic: {tag}";
        }
        else if (!bookingReq.Notes.Contains(tag))
        {
            bookingReq.Notes += $", {tag}";
        }
    }

    private decimal CalculateTotal()
    {
        if (therapist == null) return 150.00m;
        var factor = bookingReq.DurationMinutes switch
        {
            30 => 0.60m,
            90 => 1.45m,
            _ => 1.00m
        };
        return Math.Round(therapist.HourlyRate * factor, 2);
    }

    private async Task ProcessBooking()
    {
        if (therapist == null) return;
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var session = await BookingService.BookSessionAsync(bookingReq);
            if (session == null)
            {
                errorMessage = "Failed to create session booking. Please try again.";
                isSubmitting = false;
                return;
            }

            var initReq = new InitializePaymentRequest
            {
                SessionId = session.Id,
                Email = bookingReq.ClientEmail,
                Amount = CalculateTotal(),
                CallbackUrl = $"{NavManager.BaseUri}payment-history"
            };

            var paystackRes = await BookingService.InitializePaymentAsync(initReq);
            var refCode = paystackRes?.Data?.Reference ?? $"COGNIA-PAY-{Guid.NewGuid().ToString()[..8].ToUpper()}";

            var dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JSRuntime.InvokeVoidAsync("paystackInterop.payWithPaystack", "pk_test_cce97442fea16049dd3622d782b3984ad03cd27e", bookingReq.ClientEmail, CalculateTotal(), refCode, dotNetRef);
            }
            catch
            {
                // Fallback to direct redirect if JS interop fails
                await BookingService.VerifyPaymentAsync(refCode);
                NavManager.NavigateTo("/payment-history");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
            isSubmitting = false;
        }
    }

    [JSInvokable]
    public async Task OnPaymentSuccess(string reference)
    {
        await BookingService.VerifyPaymentAsync(reference);
        NavManager.NavigateTo("/payment-history");
    }

    [JSInvokable]
    public void OnPaymentClosed()
    {
        isSubmitting = false;
        StateHasChanged();
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "TH";
        var parts = name.Replace("Dr. ", "").Replace(", Ph.D.", "").Replace(", M.Sc.", "").Replace(", MA", "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
    }

    private string GetBgColorClass(int id) => (id % 4) switch
    {
        1 => "bg-blue",
        2 => "bg-teal",
        3 => "bg-purple",
        _ => "bg-indigo"
    };
}
