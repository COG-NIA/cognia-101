@page "/book-session/{TherapistId:int}"
@using Cognia.Shared.Models
@using Cognia.Client.Services
@inject PaymentBookingService BookingService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime

<PageTitle>Book 1-on-1 Therapy Consultation | Cognia</PageTitle>

<div class="dashboard" id="booking-page">
    <main>
        <section class="welcome-band">
            <div class="welcome-copy">
                <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> CONFIDENTIAL & EMBEDDED THERAPY CARE</p>
                <h1>Schedule your <em>1-on-1 consultation.</em></h1>
                <p class="welcome-lede">Select your preferred session mode, pick a duration, choose a date & time slot, and confirm your private session securely.</p>
                <a href="/therapists" class="back-btn" style="margin-top:0.75rem;">← Specialists</a>
            </div>
        </section>

        <div class="content-wrap">
            @if (isLoading)
            {
                <div class="loading-state">
                    <p>Loading specialist details and available calendar schedule...</p>
                </div>
            }
            else if (therapist == null)
            {
                <div class="error-state">
                    <p>Therapist profile not found.</p>
                    <a href="/therapists" class="action-btn secondary">Back to Directory</a>
                </div>
            }
            else
            {
                <!-- Emergency Crisis Notice Banner -->
                <div class="crisis-notice">
                    <span>🆘 <strong>In Immediate Crisis?</strong> If you are experiencing a mental health emergency, please reach out to the Ghana Mental Health Authority Helpline at <strong>0800 678 678</strong> or visit your nearest medical emergency room.</span>
                </div>

                <!-- Progress Stepper -->
                <div class="stepper-bar">
                    <div class="step-item active"><span class="step-num">1</span> Consultation Options</div>
                    <div class="step-item active"><span class="step-num">2</span> Date & Time Slot</div>
                    <div class="step-item active"><span class="step-num">3</span> Therapy Focus & Payment</div>
                </div>

                <div class="booking-layout">
                    <!-- Left Column: Comprehensive Registration Form -->
                    <div class="booking-card form-card">
                        <div class="card-title-row">
                            <h2>Session Registration Details</h2>
                            <span class="confidential-badge">🔒 100% Private & Encrypted</span>
                        </div>
                        <p class="form-subtext">All sessions are conducted in private, end-to-end encrypted rooms.</p>
                        
                        <form @onsubmit="ProcessBooking" @onsubmit:preventDefault>
                            
                            <!-- 1. Session Format Selection -->
                            <div class="form-group">
                                <label class="section-label">1. Select Consultation Format</label>
                                <div class="mode-grid">
                                    <div class="mode-card @(bookingReq.SessionMode == "Encrypted Video Call" ? "selected" : "")" @onclick='() => SetSessionMode("Encrypted Video Call")'>
                                        <div class="mode-icon">🎥</div>
                                        <div class="mode-title">Video Call</div>
                                        <div class="mode-desc">Face-to-face HD encrypted video via Jitsi</div>
                                    </div>
                                    <div class="mode-card @(bookingReq.SessionMode == "Private Audio Call" ? "selected" : "")" @onclick='() => SetSessionMode("Private Audio Call")'>
                                        <div class="mode-icon">🎙️</div>
                                        <div class="mode-title">Audio Call</div>
                                        <div class="mode-desc">Private voice-only consultation</div>
                                    </div>
                                    <div class="mode-card @(bookingReq.SessionMode == "Confidential Text Chat" ? "selected" : "")" @onclick='() => SetSessionMode("Confidential Text Chat")'>
                                        <div class="mode-icon">💬</div>
                                        <div class="mode-title">Live Chat</div>
                                        <div class="mode-desc">Real-time confidential structured text</div>
                                    </div>
                                </div>
                            </div>

                            <!-- 2. Session Duration Selection -->
                            <div class="form-group">
                                <label class="section-label">2. Select Consultation Duration</label>
                                <div class="duration-pills">
                                    <button type="button" class="dur-pill @(bookingReq.DurationMinutes == 30 ? "selected" : "")" @onclick="() => SetDuration(30)">
                                        ⏱️ 30 Mins <span class="dur-price">(GH₵ @((therapist.HourlyRate * 0.6m).ToString("F2")))</span>
                                    </button>
                                    <button type="button" class="dur-pill @(bookingReq.DurationMinutes == 60 ? "selected" : "")" @onclick="() => SetDuration(60)">
                                        ⏱️ 60 Mins (Standard) <span class="dur-price">(GH₵ @therapist.HourlyRate.ToString("F2"))</span>
                                    </button>
                                    <button type="button" class="dur-pill @(bookingReq.DurationMinutes == 90 ? "selected" : "")" @onclick="() => SetDuration(90)">
                                        ⏱️ 90 Mins (In-Depth) <span class="dur-price">(GH₵ @((therapist.HourlyRate * 1.45m).ToString("F2")))</span>
                                    </button>
                                </div>
                            </div>

                            <!-- 3. Client Information -->
                            <div class="form-group">
                                <label class="section-label">3. Client Contact Information</label>
                                <div class="form-row">
                                    <div class="input-field">
                                        <label for="clientName">Your Full Name *</label>
                                        <input id="clientName" type="text" class="input-control" @bind="bookingReq.ClientName" placeholder="e.g. Lois Osei-Bonsu" required />
                                    </div>

                                    <div class="input-field">
                                        <label for="clientEmail">Email Address (For receipts & Video link) *</label>
                                        <input id="clientEmail" type="email" class="input-control" @bind="bookingReq.ClientEmail" placeholder="e.g. lois@example.com" required />
                                    </div>
                                </div>
                            </div>

                            <!-- 4. Date & Time Selection -->
                            <div class="form-group">
                                <label class="section-label">4. Schedule Date & Available Time Slot</label>
                                <div class="form-row" style="margin-bottom:0.75rem;">
                                    <div class="input-field">
                                        <label for="sessionDate">Consultation Date *</label>
                                        <input id="sessionDate" type="date" class="input-control" @bind="bookingReq.SessionDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="input-field">
                                        <label>Therapist Working Days</label>
                                        <div class="working-days-bar">
                                            @foreach (var day in therapist.AvailableDays)
                                            {
                                                <span class="working-day-chip">✓ @day</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <label style="font-size:0.85rem; color:#4a5568; font-weight:600; margin-bottom:0.4rem; display:block;">Select Time Slot *</label>
                                <div class="time-chips">
                                    @foreach (var slot in therapist.TimeSlots)
                                    {
                                        <button type="button" class="time-chip @(bookingReq.TimeSlot == slot ? "selected" : "")" @onclick="() => bookingReq.TimeSlot = slot">
                                            🕒 @slot
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- 5. Therapy Focus & Notes -->
                            <div class="form-group">
                                <label class="section-label">5. Therapy Goals & Topics of Focus (Optional)</label>
                                <p style="font-size:0.8rem; color:#718096; margin-bottom:0.5rem;">Click quick tags below to auto-fill or write your own notes for your specialist:</p>
                                
                                <div class="focus-tags">
                                    <button type="button" class="tag-chip" @onclick='() => AddFocusTag("Exam & Academic Stress")'>+ Academic Stress</button>
                                    <button type="button" class="tag-chip" @onclick='() => AddFocusTag("Anxiety & Panic Attacks")'>+ Anxiety & Panic</button>
                                    <button type="button" class="tag-chip" @onclick='() => AddFocusTag("Burnout & Fatigue")'>+ Burnout & Fatigue</button>
                                    <button type="button" class="tag-chip" @onclick='() => AddFocusTag("Relationship Conflict")'>+ Relationship Conflict</button>
                                    <button type="button" class="tag-chip" @onclick='() => AddFocusTag("Grief & Loss")'>+ Grief & Loss</button>
                                    <button type="button" class="tag-chip" @onclick='() => AddFocusTag("Self-Esteem & Identity")'>+ Self-Esteem</button>
                                </div>

                                <textarea id="notes" class="input-control textarea" @bind="bookingReq.Notes" rows="3" placeholder="Share any feelings, background context, or specific goals for your therapist..."></textarea>
                            </div>

                            <!-- Client Preparation Checklist Accordion -->
                            <div class="prep-accordion">
                                <h4>💡 What to expect during your consultation:</h4>
                                <ul>
                                    <li>✓ You will receive an instant confirmation email with your encrypted 1-on-1 Jitsi meeting link.</li>
                                    <li>✓ Ensure you are in a quiet, private environment 5 minutes before your scheduled start time.</li>
                                    <li>✓ All discussions remain 100% confidential under ethical professional standards.</li>
                                </ul>
                            </div>

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert-box error">@errorMessage</div>
                            }

                            <button type="submit" class="action-btn pay-btn" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span>Processing Booking & Initializing Paystack...</span>
                                }
                                else
                                {
                                    <span>Proceed to Pay GH₵ @CalculateTotal().ToString("F2")</span>
                                }
                            </button>
                        </form>
                    </div>

                    <!-- Right Column: Professional Summary Sidebar -->
                    <aside class="booking-card summary-card">
                        <h3 class="summary-title">Consultation Summary</h3>
                        
                        <div class="summary-header">
                            <div class="avatar-monogram @GetBgColorClass(therapist.Id)">
                                @GetInitials(therapist.Name)
                            </div>
                            <div>
                                <h3>@therapist.Name</h3>
                                <p class="sub-title">@therapist.Title</p>
                                <span class="badge">@therapist.Specialization</span>
                            </div>
                        </div>

                        <div class="therapist-specs-list">
                            <div class="spec-row">
                                <span class="spec-label">Experience:</span>
                                <span class="spec-val">@therapist.YearsExperience+ years</span>
                            </div>
                            <div class="spec-row">
                                <span class="spec-label">Languages:</span>
                                <span class="spec-val">@string.Join(", ", therapist.Languages)</span>
                            </div>
                            <div class="spec-row">
                                <span class="spec-label">Approach:</span>
                                <span class="spec-val">@therapist.Approach</span>
                            </div>
                        </div>

                        <hr class="divider" />

                        <div class="summary-breakdown">
                            <div class="row">
                                <span>Format:</span>
                                <strong>@bookingReq.SessionMode</strong>
                            </div>
                            <div class="row">
                                <span>Duration:</span>
                                <strong>@bookingReq.DurationMinutes Mins</strong>
                            </div>
                            <div class="row">
                                <span>Date & Time:</span>
                                <strong>@bookingReq.SessionDate.ToString("MMM d") at @bookingReq.TimeSlot</strong>
                            </div>
                            <div class="row">
                                <span>Consultation Fee:</span>
                                <span>GH₵ @CalculateTotal().ToString("F2")</span>
                            </div>
                            <div class="row">
                                <span>Encrypted Jitsi Call:</span>
                                <span class="free-label">Included Free</span>
                            </div>
                            <div class="row total-row">
                                <span>Total Amount:</span>
                                <span>GH₵ @CalculateTotal().ToString("F2")</span>
                            </div>
                        </div>

                        <div class="guarantee-box">
                            <span class="shield-icon">🛡️</span>
                            <div>
                                <strong>100% Satisfaction Guarantee</strong>
                                <p>If your session is interrupted due to network issues, easily reschedule at no additional cost.</p>
                            </div>
                        </div>
                    </aside>
                </div>
            }
        </div>
    </main>
</div>

<style>
