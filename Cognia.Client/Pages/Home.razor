@page "/"
@using System.Text.Json
@inject IJSRuntime JS

<PageTitle>Cognia | Your wellbeing, in focus</PageTitle>

<div class="dashboard" id="top">
	<main>
		<section class="welcome-band" aria-labelledby="welcome-title">
			<div class="welcome-copy">
				<p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> YOUR PERSONAL WELLBEING SPACE</p>
				<h1 id="welcome-title">A little more in tune<br />with <em>you.</em></h1>
				<p class="welcome-lede">Some days are easy to read. Others, not so much. Start wherever you are.</p>
				<a class="text-link" href="#check-in">Check in with yourself <span aria-hidden="true">↓</span></a>
			</div>
			<div class="welcome-art" role="img" aria-label="A quiet sunlit landscape with rolling green hills">
				<div class="sun" aria-hidden="true"></div>
				<div class="hill hill-back" aria-hidden="true"></div>
				<div class="hill hill-front" aria-hidden="true"></div>
				<div class="art-caption"><span>01</span> MAKE SPACE FOR HOW YOU FEEL</div>
			</div>
		</section>

		<div class="content-wrap">
			<section class="checkin-section" id="check-in" aria-labelledby="checkin-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow">A DAILY PAUSE</p>
						<h2 id="checkin-title">How are you feeling?</h2>
					</div>
					<span class="today-label">@DateTime.Now.ToString("dddd, MMMM d")</span>
				</div>

				<div class="checkin-layout">
					<form class="mood-form" @onsubmit="SaveMood" @onsubmit:preventDefault>
						<fieldset class="mood-picker">
							<legend>Choose the feeling that comes closest. There is no wrong answer.</legend>
							<div class="mood-options">
								@foreach (var mood in Moods)
								{
									<button type="button" class="mood-option @(selectedScore == mood.Score ? "selected" : "")"
											aria-pressed="@(selectedScore == mood.Score)"
											@onclick="() => selectedScore = mood.Score">
										<span class="mood-face" aria-hidden="true">@mood.Face</span>
										<span>@mood.Label</span>
									</button>
								}
							</div>
						</fieldset>

						<label class="notes-label" for="mood-notes">Anything behind that feeling? <span>Optional</span></label>
						<textarea id="mood-notes" @bind="notes" maxlength="240" rows="3"
								  placeholder="A moment, a thought, or just a few words..."
								  aria-describedby="notes-hint"></textarea>
						<div class="form-footer">
							<span id="notes-hint">Only you can see your notes on this device.</span>
							<button class="primary-button" type="submit" disabled="@(selectedScore is null)">Save check-in <span aria-hidden="true">→</span></button>
						</div>
						<p class="save-message" role="status" aria-live="polite">@saveMessage</p>
					</form>

					<aside class="checkin-aside" aria-label="Check-in encouragement">
						<span class="aside-mark" aria-hidden="true">✳</span>
						<p class="aside-quote">“You don't have to have it all figured out to take the next small step.”</p>
						<span class="aside-credit">A NOTE TO YOURSELF</span>
						<div class="privacy-note"><span aria-hidden="true">◎</span> Your check-ins stay in this browser.</div>
					</aside>
				</div>
			</section>

			<section class="trend-section" id="your-trend" aria-labelledby="trend-title">
				<div class="section-heading trend-heading">
					<div>
						<p class="eyebrow">NOTICE YOUR PATTERNS</p>
						<h2 id="trend-title">Your mood, over time</h2>
					</div>
					<div class="range-toggle" role="group" aria-label="Mood chart time range">
						<button type="button" class="@(rangeDays == 7 ? "active" : "")" aria-pressed="@(rangeDays == 7)" @onclick="() => rangeDays = 7">7 days</button>
						<button type="button" class="@(rangeDays == 30 ? "active" : "")" aria-pressed="@(rangeDays == 30)" @onclick="() => rangeDays = 30">30 days</button>
					</div>
				</div>
				<div class="trend-panel">
					@if (VisibleEntries.Count == 0)
					{
						<div class="empty-trend">
							<span class="empty-spark" aria-hidden="true">✳</span>
							<div><h3>Your story starts here</h3><p>Log a check-in and your mood will appear here. Over time, you may notice patterns worth exploring.</p></div>
							<a class="text-link" href="#check-in">Add your first check-in <span aria-hidden="true">↑</span></a>
						</div>
					}
					else
					{
						<div class="chart-summary"><span>@VisibleEntries.Count check-in@(VisibleEntries.Count == 1 ? "" : "s")</span><span>Most recent: @Moods.First(m => m.Score == VisibleEntries[^1].Score).Label</span></div>
						<div class="mood-chart" role="img" aria-label="Mood check-ins over the last @rangeDays days. @ChartDescription">
							@foreach (var entry in VisibleEntries)
							{
								<div class="chart-column" title="@entry.Date.ToString("MMM d"): @Moods.First(m => m.Score == entry.Score).Label">
									<span class="chart-score">@Moods.First(m => m.Score == entry.Score).Label</span>
									<div class="chart-track"><div class="chart-bar score-@entry.Score" style="height: @(entry.Score * 20)%"></div></div>
									<span class="chart-date">@entry.Date.ToString(rangeDays == 7 ? "ddd" : "MMM d")</span>
								</div>
							}
						</div>
						<p class="chart-footnote">A check-in is a snapshot, not a score. Every feeling is worth noticing.</p>
					}
				</div>
			</section>

			<section class="library-section" id="self-help" aria-labelledby="library-title">
				<div class="library-intro">
					<div>
						<p class="eyebrow">A PLACE TO BEGIN</p>
						<h2 id="library-title">A few good things to read.</h2>
						<p>Small, thoughtful reads for wherever your mind is today.</p>
					</div>
					<span class="library-count">@FilteredArticles.Count() READS TO EXPLORE</span>
				</div>

				<div class="article-tools">
					<div class="category-list" role="group" aria-label="Filter articles by topic">
						@foreach (var category in Categories)
						{
							<button type="button" class="category-button @(activeCategory == category ? "active" : "")"
									aria-pressed="@(activeCategory == category)" @onclick="() => activeCategory = category">@category</button>
						}
					</div>
					<label class="search-box">
						<span aria-hidden="true">⌕</span>
						<span class="visually-hidden">Search articles</span>
						<input @bind="searchTerm" @bind:event="oninput" placeholder="Search the library" />
					</label>
				</div>

				<div class="article-grid">
					@foreach (var article in FilteredArticles)
					{
						<article class="article-card">
							<div class="article-image image-@article.ImageClass" role="img" aria-label="@article.ImageAlt">
								<span class="article-category">@article.Category</span>
							</div>
							<div class="article-body">
								<div class="article-meta"><span>@article.ReadTime MIN READ</span><span aria-hidden="true">·</span><span>@article.Kind</span></div>
								<h3>@article.Title</h3>
								<p>@article.Summary</p>
								<button class="article-link" type="button" @onclick="() => OpenArticle(article)">
									Read this piece <span aria-hidden="true">↗</span>
								</button>
							</div>
						</article>
					}
				</div>

				@if (!FilteredArticles.Any())
				{
					<p class="no-articles" role="status">No reads match that search. Try another word or topic.</p>
				}
			</section>

			@if (selectedArticle is not null)
			{
				<section class="reading-panel" aria-labelledby="reading-title" aria-live="polite">
					<div class="reading-header">
						<div><p class="eyebrow">@selectedArticle.Category · @selectedArticle.ReadTime MIN READ</p><h2 id="reading-title" tabindex="-1">@selectedArticle.Title</h2></div>
						<button class="close-reading" type="button" aria-label="Close article" @onclick="() => selectedArticle = null">×</button>
					</div>
					<p>@selectedArticle.Body</p>
					<p class="reading-signoff">Take what helps. Leave the rest.</p>
				</section>
			}
		</div>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true">c</span><span>cognia<span class="brand-period">.</span></span></a>
			<p>A gentle place to check in with yourself.</p>
			<a href="#top" class="back-top">Back to top ↑</a>
		</footer>
	</div>

@code {
	private const string StorageKey = "cognia.moodEntries";
	private int? selectedScore;
	private string notes = "";
	private string searchTerm = "";
	private string activeCategory = "All reads";
	private int rangeDays = 7;
	private string saveMessage = "";
	private List<MoodEntry> entries = [];
	private Article? selectedArticle;

	private static readonly (int Score, string Label, string Face)[] Moods =
	[
		(5, "Good", "☺"), (4, "Okay", "◡"), (3, "Mixed", "◠"), (2, "Low", "☹"), (1, "Anxious", "〰")
	];

	private static readonly string[] Categories = ["All reads", "Stress", "Sleep", "Grief", "Student life"];

	private static readonly List<Article> Articles =
	[
		new("Stress", "When everything feels like too much", "A small reset for the moments when your to-do list gets louder than you do.", 4, "GUIDE", "calm", "Sunlight falling across a quiet green landscape", "Start with one thing. Not the whole list, just the next kind, possible thing. Put both feet on the floor and let your shoulders fall. Take one slow breath out, a little longer than the breath in. Then choose a task small enough to begin in two minutes. You do not need to solve the whole day at once. A pause is not falling behind; it is a way to find your footing again."),
		new("Sleep", "A softer landing at the end of the day", "A few gentle ways to help your mind shift out of busy mode and into rest.", 5, "PRACTICE", "sleep", "A calm bedroom with warm evening light", "Rest does not always arrive on command. Try making the last part of your day a little quieter: dim a light, set tomorrow's first task on paper, or give yourself five minutes without a screen. If thoughts keep coming, you might tell yourself, 'I can return to this tomorrow.' Small cues of safety and routine can help the body understand that it is allowed to slow down."),
		new("Student life", "You are more than your grades", "For the weeks when deadlines pile up and it gets hard to see past them.", 3, "REFLECTION", "study", "An open notebook and a cup beside a window", "When pressure builds, it can feel as though one result says everything about you. It does not. Your effort, curiosity, relationships, and the way you recover after a hard day are part of your story too. Try naming one thing you learned, not only what you finished. If school feels unmanageable, telling someone you trust is a practical first step, not a failure."),
		new("Grief", "There is no timetable for missing someone", "Making room for a feeling that may change shape from one day to the next.", 4, "REFLECTION", "grief", "A quiet path through trees after rainfall", "Grief can be present in ordinary moments and unexpected places. You do not have to make it smaller or find the right words for it. Some people find comfort in a simple ritual, a memory shared with someone safe, or taking the day one hour at a time. If today is harder than yesterday, that does not erase the steps you have already taken. Support is allowed, whenever you need it."),
		new("Stress", "A breathing pause you can take anywhere", "No special setup needed. Just one minute to arrive back in the present.", 2, "EXERCISE", "breath", "Leaves moving gently in soft afternoon light", "Let your jaw unclench and rest your hands somewhere comfortable. Breathe in through your nose if that feels okay, then breathe out slowly, like you are cooling a warm drink. Notice one thing you can see and one thing your body is touching. Repeat for a few rounds at your own pace. If focusing on your breath feels uncomfortable, try noticing the sounds around you instead."),
		new("Student life", "Asking for help is a skill", "How to make the first conversation feel a little less daunting.", 4, "GUIDE", "support", "A sunlit bench in a peaceful garden", "You can begin simply: 'I have been having a hard time and could use someone to listen.' You do not need a complete explanation before reaching out. Think of one person who usually makes you feel respected, or a counsellor or support service at your school. You can also write down what you want them to know first. Reaching out is one way of looking after yourself.")
	];

	private IEnumerable<Article> FilteredArticles => Articles.Where(article =>
		(activeCategory == "All reads" || article.Category == activeCategory) &&
		(string.IsNullOrWhiteSpace(searchTerm) || article.Title.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || article.Summary.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || article.Category.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

	private List<MoodEntry> VisibleEntries => entries
		.Where(entry => entry.Date.Date >= DateTime.Today.AddDays(-(rangeDays - 1)) && entry.Date.Date <= DateTime.Today)
		.OrderBy(entry => entry.Date)
		.ToList();

	private string ChartDescription => string.Join(", ", VisibleEntries.Select(entry => $"{entry.Date:MMM d}: {Moods.First(mood => mood.Score == entry.Score).Label}"));

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
			if (!string.IsNullOrWhiteSpace(saved))
				entries = JsonSerializer.Deserialize<List<MoodEntry>>(saved) ?? [];
		}
		catch (Exception)
		{
			saveMessage = "Browser storage is unavailable. Your check-ins will last until you close this page.";
		}
	}

	private async Task SaveMood()
	{
		if (selectedScore is null)
			return;

		entries.Add(new MoodEntry { Date = DateTime.Today, Score = selectedScore.Value, Note = notes.Trim() });
		try
		{
			await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(entries));
			saveMessage = "Check-in saved. Thank you for taking a moment for yourself.";
		}
		catch (Exception)
		{
			saveMessage = "Check-in added for this visit. Browser storage is unavailable, so it will not be saved after you leave.";
		}

		selectedScore = null;
		notes = "";
	}

	private void OpenArticle(Article article)
	{
		selectedArticle = article;
	}

	private sealed class MoodEntry
	{
		public DateTime Date { get; set; }
		public int Score { get; set; }
		public string Note { get; set; } = "";
	}

	private sealed record Article(string Category, string Title, string Summary, int ReadTime, string Kind, string ImageClass, string ImageAlt, string Body);
}
