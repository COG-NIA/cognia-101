@page "/"

<PageTitle>Cognia | Home</PageTitle>

<div class="dashboard-shell">
    <section class="hero-panel">
        <div>
            <p class="eyebrow">Mental wellness support</p>
            <h1>Welcome back, Maya.</h1>
            <p class="lead">Track your mood, access calming tools, and stay connected to a supportive community.</p>
        </div>
        <div class="cta-row">
            <NavLink class="primary-button" href="mood-tracker">Log your mood</NavLink>
            <NavLink class="secondary-button" href="self-help">Explore resources</NavLink>
        </div>
    </section>

    <section class="stats-grid" aria-label="Wellness overview">
        <article class="stat-card">
            <span class="stat-label">Current mood</span>
            <strong class="stat-value">Calm</strong>
            <small>Steady progress this week</small>
        </article>
        <article class="stat-card">
            <span class="stat-label">Check-ins</span>
            <strong class="stat-value">5/7</strong>
            <small>Consistency is improving</small>
        </article>
        <article class="stat-card">
            <span class="stat-label">Support tools</span>
            <strong class="stat-value">12</strong>
            <small>Helpful resources ready</small>
        </article>
    </section>

    <section class="feature-grid">
        <article class="feature-card">
            <span class="feature-icon" aria-hidden="true">🌤️</span>
            <h2>Mood tracker</h2>
            <p>Reflect on your emotional patterns and notice what supports your wellbeing.</p>
            <NavLink href="mood-tracker">Open tracker</NavLink>
        </article>

        <article class="feature-card">
            <span class="feature-icon" aria-hidden="true">📘</span>
            <h2>Self-Help Hub</h2>
            <p>Read practical strategies for managing stress, sleep, focus, and everyday resilience.</p>
            <NavLink href="self-help">Browse articles</NavLink>
        </article>

        <article class="feature-card">
            <span class="feature-icon" aria-hidden="true">💬</span>
            <h2>Safe Space Forum</h2>
            <p>Speak openly in a moderated, compassionate space built around community encouragement.</p>
            <NavLink href="forum">Join discussion</NavLink>
        </article>
    </section>
</div>

<style>
    .dashboard-shell {
        padding: 2rem;
        color: #1f2937;
    }

    .hero-panel {
        display: flex;
        justify-content: space-between;
