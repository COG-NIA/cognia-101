@page "/login"
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Sign in | Cognia</PageTitle>

<main class="account-page">
    <h1>Sign in</h1>
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <label for="email">Email</label>
        <input id="email" type="email" autocomplete="email" @bind="email" required />
        <label for="password">Password</label>
        <input id="password" type="password" autocomplete="current-password" @bind="password" required />
        @if (!string.IsNullOrWhiteSpace(message)) { <p role="alert">@message</p> }
        <button type="submit" disabled="@submitting">@(submitting ? "Signing in..." : "Sign in")</button>
    </form>
    <p>New to Cognia? <a href="/register">Create an account</a>.</p>
</main>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;
    private bool submitting;

    private async Task SubmitAsync()
    {
        submitting = true;
        try
        {
            message = await AuthService.LoginAsync(email, password) ?? string.Empty;
            if (string.IsNullOrEmpty(message)) Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (HttpRequestException)
        {
            message = "Unable to reach the service. Try again later.";
        }
        finally
        {
            submitting = false;
        }
    }
}