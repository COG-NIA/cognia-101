@page "/self-help"
@using Cognia.Shared.Models
@inject HttpClient Http

<PageTitle>Cognia | Self-Help Hub</PageTitle>

<div class="selfhelp-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Support resources</p>
            <h1>Self-Help Hub</h1>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(loadError))
    {
        <p role="alert">@loadError</p>
    }
    else if (articles.Count == 0)
    {
        <p>No resources have been published yet.</p>
    }
    else
    {
        <section class="articles-grid">
            @foreach (var article in articles)
            {
                <article class="article-card">
                    <span class="tag">@article.Category</span>
                    <h2>@article.Title</h2>
                    <p>@article.Summary</p>
                    <details>
                        <summary>Read article</summary>
                        <p>@article.Body</p>
                    </details>
                </article>
            }
        </section>
    }
</div>

@code {
    private List<WellnessArticle> articles = [];
    private string loadError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            articles = await Http.GetFromJsonAsync<List<WellnessArticle>>("api/articles") ?? [];
        }
        catch (HttpRequestException)
        {
            loadError = "Unable to load resources. Check your connection and try again.";
        }
    }
}

<style>
    .selfhelp-shell {
        padding: 2rem;
        color: #1f2937;
    }

    .page-header {
        margin-bottom: 1.5rem;
    }

    .eyebrow {
        margin: 0 0 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        font-weight: 700;
        color: #0f766e;
    }

    h1, h2, p {
        margin-top: 0;
    }

    .quick-steps,
    .articles-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .step-card,
    .article-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 1.25rem;
        box-shadow: 0 10px 25px rgba(17, 24, 39, 0.03);
    }

    .step-card span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #ecfeff;
        font-size: 1.7rem;
        margin-bottom: 0.8rem;
    }

    .tag {
        display: inline-block;
        background: #ecfeff;
        color: #0f766e;
        font-size: 0.75rem;
        font-weight: 700;
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        margin-bottom: 0.7rem;
    }

    .link-button {
        margin-top: 0.9rem;
        border: none;
        background: transparent;
        color: #4f46e5;
        font-weight: 700;
        cursor: pointer;
        padding: 0;
    }

    .article-card p,
    .step-card p {
        color: #4b5563;
        line-height: 1.6;
    }

    @@media (max-width: 640px) {
        .selfhelp-shell {
            padding: 1rem;
        }
    }
</style>
